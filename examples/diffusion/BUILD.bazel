load("@rules_zig//zig:defs.bzl", "zig_binary")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

zig_binary(
    name = "diffusion",
    srcs = glob(["**/*.zig"]),
    main = "main.zig",
    visibility = ["//visibility:public"],
    deps = [
        "//zml",
        "@zigimg",
    ],
)

build_test(
    name = "test",
    targets = [":diffusion"],
)
